# Follow README.md to install dependencies and create a private .env.
# Set APP_PASSWORD to a unique value of at least 16 characters.
# Never copy another device's .env or .venv. Recreate them from this template/locks.
# Replace placeholders with measured Host-only addresses; no live defaults.
APP_HOST=<KALI_LAB_IP>
APP_PORT=8000
APP_USERNAME=labadmin
APP_PASSWORD=
LAB_TARGET_ID=dvwa
# Long-term sanitized scan history; never commit the database.
HISTORY_DB_PATH=data/penchecker.sqlite3
# AI settings saved in the UI override AI fields via private .env.ai.
LAB_TARGET_IP=<METASPLOIT_LAB_IP>
LAB_TARGET_URL=http://<METASPLOIT_LAB_IP>/dvwa
DVWA_AUTH_MODE=public_only_unknown
DVWA_SECURITY_LEVEL=unknown
# Known default lab login; every web tool obtains its own fresh verified session.
DVWA_USERNAME=admin
DVWA_PASSWORD=password
MAX_CONCURRENT_TOOLS=3
TOOL_CAPTURE_LIMIT_BYTES=524288
RETAIN_COMPLETED_SCANS=10
SCAN_TTL_SECONDS=3600
AI_TOTAL_TIMEOUT_SECONDS=180
AI_INPUT_UTF8_BYTES=12000
AI_OUTPUT_TOKENS=3072
AI_MAX_RESPONSE_BYTES=262144
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Local context allocation; verify RAM/context for the chosen model.
OLLAMA_CONTEXT_TOKENS=8192
OLLAMA_NUM_THREADS=4
# Install/pull the exact model separately; no model is downloaded by bootstrap.
# Lightweight measured fallback: qwen2.5:3b-instruct-q4_K_M
# OLLAMA_MODEL=<EXACT_INSTALLED_MODEL>
# UI: save/edit multiple external profiles under Settings → Provider AI.
# Profiles/keys are private .env.ai overrides; do not add them to source control.
# Legacy profile below remains supported. HTTPS origins, base URLs and full
# /chat/completions URLs are accepted.
# OPENAI_BASE_URL=https://<PROVIDER_HOST>/v1
OPENAI_PROVIDER_NAME=External AI
# OPENAI_MODEL_DISPLAY_NAME=<OPTIONAL_LABEL>
# OPENAI_API_KEY=<SET_LOCALLY>
# OPENAI_MODEL=<EXACT_SUPPORTED_MODEL>
OPENAI_OUTPUT_MODE=json_schema
OPENAI_TOKEN_LIMIT_FIELD=max_tokens
